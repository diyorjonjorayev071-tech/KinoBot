# PostgreSQL ishlatilsa Railway/hosting shu qiymatni beradi.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Telegram posterlarini ko'rsatish uchun bot token (majburiy emas).
# BOT_TOKEN=

# "Ko'rish" tugmasi ochadigan bot.
BOT_USERNAME=xDKinoCodeBot

# Deep-link prefiksi. Natija: https://t.me/BOT_USERNAME?start=movie_123
BOT_START_PREFIX=movie_

# Lokal SQLite yo'li (DATABASE_URL bo'lmasa ishlatiladi).
SQLITE_PATH=xd_kino.db
